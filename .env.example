# Vault's backend credentials. Copy to .env.local and fill in.
#
# BOTH ARE OPTIONAL. With neither set, the console runs entirely in the
# browser: the simulation runs, the ledger is written and verified, and reports
# export. Setting them adds organisations, roles, a server copy of the ledger
# that cannot be edited through the app, and Telegram alerts.
#
# See supabase/README.md for the setup.

# https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# The "anon public" key from Settings -> API.
#
# This one is meant to be public and is safe in the bundle: it grants nothing
# that row-level security does not already allow. The SERVICE ROLE key is a
# different thing entirely -- it bypasses every policy, and must never appear
# in a VITE_ variable, in this file, or anywhere else in this repository. It
# belongs in Edge Function secrets, and so does the Telegram bot token.
VITE_SUPABASE_ANON_KEY=
