node_modules/
dist/
coverage/

# Playwright MCP scratch output
.playwright-mcp/
*.local

# Claude Code session worktrees
.claude/worktrees/

# Scratch screen captures taken while checking the app. Root level only, so
# real assets committed under src/ are still tracked.
/*.png
/*.jpg
/*.gif

# Backend credentials. .env.example is the tracked template; the real values
# never are. Ignore every .env variant and allow the template back, rather
# than listing the ones we happened to think of -- Vite also reads
# .env.production and .env.development, and those hold real keys too.
.env
.env.*
!.env.example
